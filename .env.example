# Meta Model API (https://dev.meta.ai)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
AGENT_MODEL=muse-wonder-1.0
VISION_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
# Baseten (Muse Spark Open)
BASETEN_API_KEY=
BASETEN_BASE_URL=
BASETEN_MODEL=meta-models/muse-spark-open-1026
# Backends: scene=mock|meta|baseten, segment=fallback|meta|local, llm=mock|meta
SCENE_BACKEND=mock
SEGMENT_BACKEND=fallback
LLM_BACKEND=mock
# 1 = read only from cache, never touch the network
DEMO_MODE=0
DATA_DIR=../data
